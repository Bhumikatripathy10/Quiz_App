<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         version="3.1">

  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>com.example.quiz.servlet.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>RegisterServlet</servlet-name>
    <servlet-class>com.example.quiz.servlet.RegisterServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>RegisterServlet</servlet-name>
    <url-pattern>/register</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AddQuizServlet</servlet-name>
    <servlet-class>com.example.quiz.servlet.AddQuizServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AddQuizServlet</servlet-name>
    <url-pattern>/addQuiz</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AddQuestionServlet</servlet-name>
    <servlet-class>com.example.quiz.servlet.AddQuestionServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AddQuestionServlet</servlet-name>
    <url-pattern>/addQuestion</url-pattern>
  </servlet-mapping>
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
</welcome-file-list>
  <servlet>
    <servlet-name>ContactServlet</servlet-name>
    <servlet-class>com.example.quiz.servlet.ContactServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>ContactServlet</servlet-name>
    <url-pattern>/ContactServlet</url-pattern>
</servlet-mapping>

<servlet>
    <servlet-name>LeaderboardServlet</servlet-name>
    <servlet-class>com.example.quiz.servlet.LeaderboardServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>LeaderboardServlet</servlet-name>
    <url-pattern>/LeaderboardServlet</url-pattern>
</servlet-mapping>
  <servlet>
    <servlet-name>AIAssistantServlet</servlet-name>
    <servlet-class>com.example.quiz.servlet.AIAssistantServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>AIAssistantServlet</servlet-name>
    <url-pattern>/AIAssistantServlet</url-pattern>
</servlet-mapping>
  <servlet>
    <servlet-name>BadgeServlet</servlet-name>
    <servlet-class>com.example.quiz.servlet.BadgeServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>BadgeServlet</servlet-name>
    <url-pattern>/BadgeServlet</url-pattern>
</servlet-mapping>
  <servlet>
    <servlet-name>LiveSessionServlet</servlet-name>
    <servlet-class>com.example.quiz.servlet.LiveSessionServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>LiveSessionServlet</servlet-name>
    <url-pattern>/createLiveSession</url-pattern>
</servlet-mapping>
  <servlet>
    <servlet-name>JoinLiveServlet</servlet-name>
    <servlet-class>com.example.quiz.servlet.JoinLiveServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>JoinLiveServlet</servlet-name>
    <url-pattern>/joinLiveSession</url-pattern>
</servlet-mapping>
  <servlet>
    <servlet-name>QuizCategoryServlet</servlet-name>
    <servlet-class>com.example.quiz.servlet.QuizCategoryServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>QuizCategoryServlet</servlet-name>
    <url-pattern>/quizCategories</url-pattern>
</servlet-mapping>
  <servlet>
    <servlet-name>InteractiveQuestionServlet</servlet-name>
    <servlet-class>com.example.quiz.servlet.InteractiveQuestionServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>InteractiveQuestionServlet</servlet-name>
    <url-pattern>/addInteractiveQuestion</url-pattern>
</servlet-mapping>
  <servlet>
  <servlet-name>DragDropQuestionServlet</servlet-name>
  <servlet-class>com.example.quiz.servlet.DragDropQuestionServlet</servlet-class>
</servlet>
<servlet-mapping>
  <servlet-name>DragDropQuestionServlet</servlet-name>
  <url-pattern>/addDragDropQuestion</url-pattern>
</servlet-mapping>
  <servlet>
    <servlet-name>DragDropQuizServlet</servlet-name>
    <jsp-file>/dragDropQuiz.jsp</jsp-file>
</servlet>

<servlet-mapping>
    <servlet-name>DragDropQuizServlet</servlet-name>
    <url-pattern>/dragQuiz</url-pattern>
</servlet-mapping>
  <servlet>
    <servlet-name>DragDropServlet</servlet-name>
    <servlet-class>com.example.quiz.servlet.DragDropServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>DragDropServlet</servlet-name>
    <url-pattern>/DragDropServlet</url-pattern>
</servlet-mapping>
  

</web-app>